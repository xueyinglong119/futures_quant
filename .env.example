TQ_USER=your_shinnytech_account
TQ_PASS=your_password
# 监控进程挂 TqKq 快期模拟，严格档开平仓同步到天勤（1=开，0=只记 MySQL 模拟账）
TQ_TRADE_ENABLE=1

MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=future_ai

# 严格档告警推飞书群机器人（自定义机器人 webhook），不配就整条静默跳过
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 配了就在卡片上加「看形态图」按钮，填手机能访问到的服务地址
HS_PUBLIC_BASE=
# 设 0 关掉飞书推送
HS_FEISHU_NOTIFY=1
