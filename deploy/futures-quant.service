[Unit]
Description=Futures Quant HTTP API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/futures_quant
EnvironmentFile=/opt/futures_quant/.env
ExecStart=/opt/futures_quant/.venv/bin/python main_api.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
